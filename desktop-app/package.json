{
  "name": "paladin-desktop",
  "version": "0.9.22",
  "private": true,
  "description": "Paladin desktop (Electron + agent-host sidecar)",
  "author": "paladin",
  "homepage": "https://github.com/Ady-JK/paladin",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "pnpm build:electron && concurrently -k \"vite --port 5173 --strictPort\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:renderer": "vite --port 5173 --strictPort",
    "dev:electron": "electron .",
    "build": "node scripts/repair-pnpm-links.mjs && vite build && pnpm build:electron && electron-builder -c electron-builder.json",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/bundle-playwright.mjs",
    "dist": "electron-builder -c electron-builder.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint . && knip && prettier --check .",
    "fmt": "prettier --write .",
    "test:build": "node --test scripts/bundle-playwright.test.mjs scripts/repair-pnpm-links.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.7.0",
    "concurrently": "^9.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.4",
    "wait-on": "^7.2.0"
  }
}
