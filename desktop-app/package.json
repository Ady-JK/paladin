{
  "name": "paladin-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Paladin desktop (Electron + agent-host sidecar)",
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild"]
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5173\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:renderer": "vite --port 5173",
    "dev:electron": "electron .",
    "build": "vite build && tsc -p tsconfig.electron.json && electron-builder",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dist": "electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  }
}
