{
  "appId": "com.paladin.app",
  "productName": "paladin",
  "directories": {
    "output": "release"
  },
  "files": ["dist/**", "dist-electron/**", "package.json"],
  "extraResources": [
    {
      "from": "../core/bin",
      "to": "agent-host",
      "filter": ["agent-host", "agent-host.exe"]
    },
    {
      "from": "voice",
      "to": "voice",
      "filter": ["worker.mjs", "NOTICES.md", "wasm/**", "models/**"]
    }
  ],
  "linux": {
    "target": ["deb"],
    "category": "Utility",
    "executableName": "paladin",
    "maintainer": "paladin"
  },
  "mac": {
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Paladin uses the microphone only for on-device dictation."
    }
  },
  "compression": "maximum"
}
